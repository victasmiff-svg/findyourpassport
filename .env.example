# Google AI Studio Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth Client ID (Google Identity Services for Google Login)
# Optional: The app includes demo/instant sign-in when no client ID is provided
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Admin Google Email for Looker Studio Analytics & Telemetry Dashboard
ADMIN_EMAIL=victasmiff@gmail.com

# Local Development Port
PORT=3000

